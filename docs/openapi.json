    "/api/auth/registro": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Crear una cuenta",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nombre",
                  "correo",
                  "contrasena"
                ],
                "properties": {
                  "nombre": {
                    "type": "string",
                    "example": "Laura Pérez Gómez"
                  },
                  "correo": {
                    "type": "string",
                    "example": "laura@correo.com"
                  },
                  "contrasena": {
                    "type": "string",
                    "example": "Prueba2026*"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cuenta creada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            }
          },
          "409": {
            "description": "Correo ya registrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Respuesta"
                }
              }
            }
          }
        }
      }
    },
